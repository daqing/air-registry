package repos

import (
	"net/url"

	"github.com/daqing/air-registry/app/services/catalog"
	"github.com/daqing/air-registry/app/services/manifests"
	"github.com/daqing/air-registry/app/views/layouts"
	"github.com/daqing/airway/lib/utils"
)

type DetailProps struct {
	Repo      *catalog.RepoDetail
	Manifest  *manifests.Expanded // nil when no tag/digest is selected
	Referrers []manifests.Referrer
	// Notice renders a small banner (e.g. an unknown tag/digest) while the
	// rest of the page still shows the repository.
	Notice string
}

// Detail renders the repository detail page: the tag table plus, when a
// manifest is selected, its config/layers (or index children), annotations
// and referrers.
templ Detail(props DetailProps) {
	@layouts.Registry(props.Repo.Name + " · Air Registry") {
		<style>
			.registry .digest { font-family: var(--aw-mono); font-size: 12px; word-break: break-all; }
			.registry dl.meta { display: grid; grid-template-columns: max-content 1fr; gap: 6px 16px; margin: 14px 0; }
			.registry dl.meta dt { color: var(--aw-muted); }
			.registry dl.meta dd { margin: 0; }
		</style>
		<div class="section-head">
			<h1>{ props.Repo.Name }</h1>
			<a href={ templ.URL(utils.URLPrefix() + "/repos") }>All repositories →</a>
		</div>
		if props.Notice != "" {
			<div class="aw-empty">
				<div class="aw-empty-title">{ props.Notice }</div>
			</div>
		}
		@tagTable(props)
		if props.Manifest != nil {
			@manifestDetail(props.Repo.Name, props.Manifest, props.Referrers)
		}
	}
}

templ tagTable(props DetailProps) {
	<div class="section-head">
		<h2>Tags</h2>
	</div>
	if len(props.Repo.Tags) == 0 {
		<div class="aw-empty">
			<div class="aw-empty-title">No tags yet</div>
			<div>Push an image with <code>docker push</code> to create one.</div>
		</div>
	} else {
		<div class="aw-table-wrap">
			<table class="aw-table">
				<thead>
					<tr>
						<th>Tag</th>
						<th>Digest</th>
						<th>Size</th>
						<th>Pushed</th>
					</tr>
				</thead>
				<tbody>
					for _, t := range props.Repo.Tags {
						<tr>
							<td><a href={ templ.URL(utils.URLPrefix() + "/repos/" + props.Repo.Name + "?tag=" + url.QueryEscape(t.Name)) }>{ t.Name }</a></td>
							<td class="digest" title={ t.Digest }>{ shortDigest(t.Digest) }</td>
							<td>{ layouts.FormatSize(t.Size) }</td>
							<td title={ t.UpdatedAt.Format("2006-01-02 15:04:05 MST") }>{ layouts.FormatTime(t.UpdatedAt) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ manifestDetail(repoName string, m *manifests.Expanded, referrers []manifests.Referrer) {
	<div class="section-head">
		<h2>Manifest</h2>
	</div>
	<div class="digest">{ m.Digest }</div>
	<dl class="meta">
		<dt>Media type</dt>
		<dd>{ m.MediaType }</dd>
		if m.ArtifactType != nil {
			<dt>Artifact type</dt>
			<dd>{ *m.ArtifactType }</dd>
		}
		<dt>Total size</dt>
		<dd>{ layouts.FormatSize(m.TotalSize) }</dd>
		if m.Subject != nil {
			<dt>Subject</dt>
			<dd><a class="digest" href={ templ.URL(utils.URLPrefix() + "/repos/" + repoName + "?digest=" + url.QueryEscape(*m.Subject)) }>{ *m.Subject }</a></dd>
		}
	</dl>
	if len(m.Annotations) > 0 {
		<dl class="meta">
			<dt>Annotations</dt>
			<dd></dd>
			for k, v := range m.Annotations {
				<dt>{ k }</dt>
				<dd>{ v }</dd>
			}
		</dl>
	}
	if m.IsIndex {
		<div class="section-head">
			<h2>Platforms</h2>
		</div>
		<div class="aw-table-wrap">
			<table class="aw-table">
				<thead>
					<tr>
						<th>Platform</th>
						<th>Digest</th>
						<th>Size</th>
					</tr>
				</thead>
				<tbody>
					for _, c := range m.Children {
						<tr>
							<td>{ c.Platform }</td>
							<td><a class="digest" href={ templ.URL(utils.URLPrefix() + "/repos/" + repoName + "?digest=" + url.QueryEscape(c.Digest)) } title={ c.Digest }>{ shortDigest(c.Digest) }</a></td>
							<td>{ layouts.FormatSize(c.Size) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	} else {
		if m.Config != nil {
			<h2 class="section-head">Config</h2>
			<div class="aw-table-wrap">
				<table class="aw-table">
					<tbody>
						<tr>
							<td class="digest" title={ m.Config.Digest }>{ shortDigest(m.Config.Digest) }</td>
							<td>{ m.Config.MediaType }</td>
							<td>{ layouts.FormatSize(m.Config.Size) }</td>
						</tr>
					</tbody>
				</table>
			</div>
		}
		<div class="section-head">
			<h2>Layers</h2>
		</div>
		if len(m.Layers) == 0 {
			<div class="aw-empty">
				<div class="aw-empty-title">No layers</div>
			</div>
		} else {
			<div class="aw-table-wrap">
				<table class="aw-table">
					<thead>
						<tr>
							<th>Digest</th>
							<th>Media type</th>
							<th>Size</th>
						</tr>
					</thead>
					<tbody>
						for _, l := range m.Layers {
							<tr>
								<td class="digest" title={ l.Digest }>{ shortDigest(l.Digest) }</td>
								<td>{ l.MediaType }</td>
								<td>{ layouts.FormatSize(l.Size) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
	if len(referrers) > 0 {
		<div class="section-head">
			<h2>Referrers</h2>
		</div>
		<div class="aw-table-wrap">
			<table class="aw-table">
				<thead>
					<tr>
						<th>Artifact type</th>
						<th>Digest</th>
						<th>Size</th>
					</tr>
				</thead>
				<tbody>
					for _, r := range referrers {
						<tr>
							<td>{ artifactTypeLabel(r.ArtifactType) }</td>
							<td><a class="digest" href={ templ.URL(utils.URLPrefix() + "/repos/" + repoName + "?digest=" + url.QueryEscape(r.Digest)) } title={ r.Digest }>{ shortDigest(r.Digest) }</a></td>
							<td>{ layouts.FormatSize(r.Size) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// artifactTypeLabel renders a nil artifact type the way the Referrers API
// omits it.
func artifactTypeLabel(t *string) string {
	if t == nil {
		return "—"
	}
	return *t
}
