package home

import (
	"strconv"

	"github.com/daqing/air-registry/app/services/catalog"
	"github.com/daqing/air-registry/app/views/layouts"
	"github.com/daqing/airway/lib/utils"
)

// Index renders the home page: a search box plus the most recently pushed
// repositories.
templ Index(recent []catalog.RepoSummary) {
	@layouts.Registry("Air Registry") {
		<section class="hero">
			<h1>Explore your registry</h1>
			<p class="muted">A private OCI registry for container images and artifacts.</p>
			<form class="search" action={ utils.URLPrefix() + "/repos" } method="get" role="search">
				<input class="aw-input" type="search" name="q" placeholder="Search repositories…" aria-label="Search repositories"/>
				<button class="aw-button aw-button-primary" type="submit">Search</button>
			</form>
		</section>
		<section>
			<div class="section-head">
				<h2>Recently pushed</h2>
				<a href={ templ.URL(utils.URLPrefix() + "/repos") }>View all →</a>
			</div>
			if len(recent) == 0 {
				<div class="aw-empty">
					<div class="aw-empty-title">No repositories yet</div>
					<div>
						Push an image to see it here, e.g.
						<code>docker push localhost:1905/demo/app:v1</code>
					</div>
				</div>
			} else {
				<div class="aw-table-wrap">
					<table class="aw-table">
						<thead>
							<tr>
								<th>Name</th>
								<th>Tags</th>
								<th>Size</th>
								<th>Updated</th>
							</tr>
						</thead>
						<tbody>
							for _, r := range recent {
								<tr>
									<td><a href={ templ.URL(utils.URLPrefix() + "/repos/" + r.Name) }>{ r.Name }</a></td>
									<td>{ strconv.FormatInt(r.TagCount, 10) }</td>
									<td>{ layouts.FormatSize(r.TotalSize) }</td>
									<td title={ r.UpdatedAt.Format("2006-01-02 15:04:05 MST") }>{ layouts.FormatTime(r.UpdatedAt) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
	}
}
