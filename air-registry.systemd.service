[Unit]
Description=Air Registry Server
After=network.target

[Service]
Type=simple
# -d pins the project directory: .env and the SQLite database live there, so
# the unit does not depend on systemd's WorkingDirectory.
ExecStart=/home/ubuntu/go/bin/air-registry -d /home/ubuntu/sites/air-registry server
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
