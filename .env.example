# Environment: "local" for local development; any other value (e.g. prod or
# production) means a production environment.
AIRWAY_ENV="local"

# Preferred database config
# DSN="postgres://[username]:[password]@[host]:5432/[dbname]"

# MySQL examples
# DSN="mysql://[username]:[password]@[host]:3306/[dbname]?charset=utf8mb4"
# DSN="[username]:[password]@tcp([host]:3306)/[dbname]?charset=utf8mb4&parseTime=true"

# SQLite examples
# DSN="sqlite://./tmp/airway.db"
# DSN="sqlite://:memory:"

# Redis
# REDIS="redis://[username]:[password]@[host]:6379/0"

# Listen Address (the Caddyfile's local HTTPS site proxies to this address)
LISTEN="127.0.0.1:1905"

# Optional sub-path prefix when deployed behind a proxy, e.g. http://host/airway/...
# URL_PREFIX="/airway"

# File storage
# Driver: local | s3 | r2 | cos
STORAGE_DRIVER="local"

# Local storage root dir (driver=local)
STORAGE_ROOT="./data/storage"

# Cloud object storage
# Amazon S3:     STORAGE_DRIVER="s3" STORAGE_REGION="us-east-1"
# Tencent COS:   STORAGE_DRIVER="cos" STORAGE_REGION="ap-guangzhou"
# Cloudflare R2: STORAGE_DRIVER="r2" STORAGE_ENDPOINT="<account_id>.r2.cloudflarestorage.com"
# STORAGE_REGION=""
# STORAGE_ENDPOINT=""   # optional endpoint override; required for r2
# STORAGE_BUCKET=""
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""
# Public base URL (e.g. CDN). When set, file URLs are built from it instead of presigned URLs
# STORAGE_PUBLIC_URL=""

# Registry
# Blob storage root (local content-addressed store). STORAGE_ROOT is still
# honored as a legacy fallback when DATA_DIR is unset.
DATA_DIR="./data/storage"
# Blob upload cap in bytes per request; 0 or unset means unlimited.
MAX_UPLOAD_SIZE="0"
# Basic auth for the OCI /v2/ API. Set REGISTRY_AUTH_USERNAME and
# REGISTRY_AUTH_PASSWORD to require credentials on every push/pull — docker
# and oras prompt for them on first use (curl: -u <user>:<pass>). Auth turns
# on whenever both are set; REGISTRY_AUTH_ENABLED is an optional explicit
# override. Enabling auth without credentials fails closed with 401.
# The web UI is never gated by these settings.
# REGISTRY_AUTH_USERNAME="admin"
# REGISTRY_AUTH_PASSWORD="change-me"
# REGISTRY_AUTH_ENABLED="true"

# Timezone
TZ="Asia/Shanghai"
